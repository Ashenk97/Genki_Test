# TEST_ENV=staging|production (optional; default staging)
# Copy to .env.staging / .env.production (or .env)
GENKI_TEST_EMAIL=your-email@example.com
GENKI_TEST_PASSWORD=your-password
GENKI_TEST_DISPLAY_NAME=Ashen

# Guest checkout billing (used by checkout specs; no secrets required)
GENKI_CHECKOUT_FIRST_NAME=Auto
GENKI_CHECKOUT_LAST_NAME=Tester
GENKI_CHECKOUT_PHONE=0771234567
GENKI_CHECKOUT_ADDRESS=123 Test Street
GENKI_CHECKOUT_ADDRESS_2=Colombo 07
GENKI_CHECKOUT_CITY=Colombo

# PayHere sandbox defaults (official sandbox cards live in fixtures/test-data.ts)
# Any valid Name / CVV / Expiry works in sandbox; card number selects the scenario.
GENKI_PAYHERE_CARD_EXPIRY=12/28
GENKI_PAYHERE_CARD_CVV=123
GENKI_PAYHERE_CARD_HOLDER=Auto Tester
