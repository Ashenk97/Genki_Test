{
  "name": "genki-wardrobe-e2e",
  "version": "1.0.0",
  "description": "End-to-end UI test automation for Genki Wardrobe (Playwright + TypeScript + POM)",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chrome",
    "test:headed": "playwright test --project=chrome --headed",
    "test:ui": "playwright test --project=chrome --ui",
    "test:debug": "playwright test --project=chrome --debug",
    "test:chrome": "playwright test --project=chrome",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all": "playwright test",
    "test:staging": "TEST_ENV=staging playwright test --project=chrome",
    "test:production": "TEST_ENV=production playwright test --project=chrome",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "codegen": "playwright codegen https://staging.genkiwardrobe.com/",
    "codegen:production": "playwright codegen https://www.genkiwardrobe.com/"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.29",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
